rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "BVDB5whKhLcRdZyS6TMFRYYnkG82";
    }

    // All user-facing Nox Vault data is scoped to the single configured owner UID.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner() && userId == request.auth.uid;
    }

    // Vault password hashes are server-only. Cloud Functions use the Admin SDK,
    // which bypasses client Security Rules.
    match /vaultSecrets/{secretId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
