{
  "manifest_version": 3,
  "name": "Nox Vault Companion (Legacy Chrome)",
  "version": "1.3.3",
  "description": "Nox Vault in-page sidebar, metadata saver, related-video helper and RAM-conscious session browser for older Chrome versions.",
  "minimum_chrome_version": "88",
  "permissions": ["tabs", "storage", "scripting", "windows"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle Nox Vault Sidebar",
    "default_icon": {
      "16": "icons/nox-16.png",
      "32": "icons/nox-32.png",
      "48": "icons/nox-48.png",
      "128": "icons/nox-128.png"
    }
  },
  "icons": {
    "16": "icons/nox-16.png",
    "32": "icons/nox-32.png",
    "48": "icons/nox-48.png",
    "128": "icons/nox-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.css", "sidepanel.js", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "panic-hide": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Hide the managed Nox session and open the decoy page"
    },
    "toggle-sidebar": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "Show or hide the Nox sidebar on the current page"
    }
  }
}
